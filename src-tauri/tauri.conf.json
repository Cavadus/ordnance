{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ordnance Mod Manager",
  "version": "0.3.0",
  "identifier": "com.cavadus.ordnance",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:checked",
    "frontendDist": "../build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ordnance"
        ]
      }
    }
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Ordnance",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#000",
        "devtools": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}